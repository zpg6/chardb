{
    "name": "@chardb/core",
    "version": "0.1.0",
    "description": "Cloudflare-native SQL with identity-owned SQLite transactions and live Drizzle queries",
    "type": "module",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://chardb.dev",
    "packageManager": "bun@1.4.1",
    "engines": {
        "bun": ">=1.2.22",
        "node": ">=22"
    },
    "bin": {
        "chardb": "./dist/cli/bin.mjs",
        "core": "./dist/cli/bin.mjs"
    },
    "files": ["dist", "README.md"],
    "workspaces": ["landing"],
    "scripts": {
        "build": "unbuild",
        "build:react": "bun run build && bun run --cwd packages/react build",
        "build:stub": "unbuild --stub",
        "prepack": "bun run build",
        "smoke:package": "bun scripts/smoke-packed-package.mjs",
        "smoke:org-user": "bun scripts/smoke-packed-org-user.mjs",
        "smoke:browser": "bun scripts/smoke-packed-browser.mjs",
        "smoke:react": "bun scripts/smoke-packed-react.mjs",
        "smoke:vector:browser": "bun scripts/smoke-packed-public-vector.mjs",
        "test": "bun scripts/test-correctness.mjs",
        "test:correctness": "bun scripts/test-correctness.mjs",
        "test:watch": "bun scripts/test-correctness.mjs --watch",
        "test:scale": "bun test test/workerd/gateway-live.harness.test.ts --test-name-pattern 'scaled SDK'",
        "bench:planned-query": "bun scripts/run-scale-benchmark.mjs --suite planned-query",
        "bench:binding-select": "bun scripts/run-scale-benchmark.mjs --suite planned-query",
        "bench:live": "bun scripts/run-scale-benchmark.mjs",
        "bench:vector:sqlite": "bun scripts/produce-vector-sqlite-benchmark.mjs",
        "bench:vector:workerd": "bun scripts/produce-native-vectorize-benchmark.mjs",
        "bench:vector:organization-deletion": "bun scripts/produce-vector-organization-deletion-benchmark.mjs",
        "bench:vector:public": "bun scripts/run-public-vector-benchmark.mjs --producer scripts/produce-public-vector-benchmark.mjs",
        "bench:vector:public:compare": "bun scripts/compare-public-vector-benchmark.mjs",
        "bench:compare": "bun scripts/compare-scale-benchmark.mjs",
        "bench:chat": "bun scripts/run-chat-benchmark.mjs",
        "bench:chat:compare": "bun scripts/compare-chat-benchmark.mjs",
        "bench:files": "bun scripts/run-file-benchmark.mjs",
        "bench:files:compare": "bun scripts/compare-file-benchmark.mjs",
        "bench:files:verify": "bun scripts/verify-file-benchmark.mjs",
        "bench:reshard": "bun scripts/run-reshard-benchmark.mjs --producer scripts/produce-native-reshard-benchmark.mjs",
        "bench:reshard:compare": "bun scripts/compare-reshard-benchmark.mjs",
        "bench:reshard:files": "bun scripts/run-file-reshard-benchmark.mjs --producer scripts/produce-native-file-reshard-benchmark.mjs",
        "bench:reshard:vectors:snapshot": "bun scripts/produce-vector-reshard-snapshot-benchmark.mjs",
        "proof:reshard:vectors:workerd": "bun test test/workerd/vector-reshard-e2e.harness.test.ts",
        "proof:cloudflare:vectors": "bun scripts/cloudflare-vectorize-proof-orchestrator.mjs",
        "proof:cloudflare:files": "bun scripts/run-cloudflare-file-proof.mjs",
        "proof:cloudflare:reshard:prepare": "bun scripts/prepare-file-reshard-deployment-proof.mjs",
        "proof:cloudflare:reshard": "bun scripts/file-reshard-proof-orchestrator.mjs",
        "preview:prepare": "bun scripts/prepare-preview-chat.mjs",
        "preview:upgrade": "bun scripts/prepare-preview-upgrade.mjs",
        "preview:cloudflare": "bun scripts/run-cloudflare-promotion.mjs",
        "security:history": "bun scripts/scan-git-history.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "format": "biome format --write ."
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./server": {
            "types": "./dist/server/index.d.mts",
            "import": "./dist/server/index.mjs"
        },
        "./internal/react": {
            "types": "./dist/internal/react.d.mts",
            "import": "./dist/internal/react.mjs"
        },
        "./files": {
            "types": "./dist/files/index.d.mts",
            "import": "./dist/files/index.mjs"
        },
        "./vite": {
            "types": "./dist/vite/index.d.mts",
            "import": "./dist/vite/index.mjs"
        }
    },
    "peerDependencies": {
        "drizzle-orm": ">=0.36.0",
        "better-auth": "~1.6.30"
    },
    "peerDependenciesMeta": {
        "better-auth": {
            "optional": true
        }
    },
    "dependencies": {
        "@noble/hashes": "^1.5.0",
        "@standard-schema/spec": "^1.1.0",
        "hono": "^4.13.3",
        "jose": "^6.1.3",
        "uuidv7": "^1.2.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^1.9.4",
        "@cloudflare/workers-types": "^4.20251005.0",
        "@types/bun": "^1.1.13",
        "@types/react": "^18.3.12",
        "@types/react-test-renderer": "^18.3.0",
        "better-auth": "~1.6.30",
        "drizzle-orm": "^0.45.2",
        "drizzle-zod": "0.8.3",
        "miniflare": "^4.20260730.0",
        "playwright-core": "^1.49.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "@types/react-dom": "^18.3.0",
        "react-test-renderer": "^18.3.1",
        "typescript": "^5.6.3",
        "unbuild": "^3.6.1",
        "zod": "^4.0.0"
    }
}
